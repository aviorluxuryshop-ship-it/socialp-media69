# Public site URL. Set it once the real domain is known; it drives canonical links,
# the sitemap, Open Graph URLs and structured data. On Vercel it falls back to the
# project's production hostname (VERCEL_PROJECT_PRODUCTION_URL) automatically.
NEXT_PUBLIC_SITE_URL=

# Private /experiments area (HTTP Basic auth, enforced server-side in src/proxy.ts).
# Set both in the hosting provider's environment settings, never in the repository.
# EXPERIMENTS_PASSWORD must be at least 16 characters; if either is missing or the
# password is too short, /experiments answers 404 (fails closed).
EXPERIMENTS_USER=
EXPERIMENTS_PASSWORD=
