{
  "name": "studyflow",
  "version": "1.0.0",
  "private": true,
  "description": "StudyFlow — Türkiye'deki lise öğrencileri için kaynak dayanaklı yapay zekâ çalışma platformu",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "catalog:fetch": "node scripts/fetch-textbooks.mjs",
    "catalog:build": "node scripts/build-catalog.mjs",
    "videos:verify": "node scripts/verify-videos.mjs",
    "test:integration": "vitest run -c vitest.integration.config.mts"
  },
  "dependencies": {
