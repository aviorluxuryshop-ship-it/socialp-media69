    "clsx": "^2.1.1",
    "geist": "^1.8.1",
    "katex": "^0.19.0",
    "lucide-react": "^1.61.0",
    "next": "^16.4.2",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
