# Bu dosyayı .env.local olarak kopyalayın (Vercel'de: Project → Settings → Environment Variables).
# .env.local dosyası git'e GİRMEZ. Gizli anahtarları asla koda ya da NEXT_PUBLIC_ ile başlayan değişkenlere yazmayın.

# Sitenin yayındaki adresi (sonunda / olmadan). Verilmezse src/data/site.ts içindeki url kullanılır.
NEXT_PUBLIC_SITE_URL=https://www.ornek-alanadi.com

# Sipariş belirteçlerini imzalamak için rastgele gizli anahtar (en az 16 karakter).
# Deneme (mock) modunda zorunlu değildir; gerçek sağlayıcıda ZORUNLUDUR.
# Üretmek için: openssl rand -base64 32
ORDER_SIGNING_SECRET=

# —— iyzico (kullanacaksanız) ——
# IYZICO_API_KEY=
# IYZICO_SECRET_KEY=
# IYZICO_BASE_URL=https://sandbox-api.iyzipay.com   # canlı: https://api.iyzipay.com

# —— PayTR (kullanacaksanız) ——
# PAYTR_MERCHANT_ID=
# PAYTR_MERCHANT_KEY=
# PAYTR_MERCHANT_SALT=
