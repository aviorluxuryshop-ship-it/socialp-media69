# Google ile giriş + bulut eşitleme (Firebase). Değerleri Firebase konsolunda
# Project settings → General → Your apps → Web app bölümünde bulursun.
# Bunlar herkese açık web yapılandırmasıdır (gizli anahtar değil); güvenlik Firestore kurallarıyla sağlanır.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# İsteğe bağlı. Boşsa <PROJECT_ID>.firebaseapp.com kullanılır.
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
